# Copy to .env and fill in — never commit the real .env file.

# Optional: enables the Claude-powered natural-language screener.
# Without this, NLScreener silently falls back to a keyword parser
# (see /DRAWBACKS.md, "Silent capability downgrade").
ANTHROPIC_API_KEY=

# Required only if you run alerts/telegram_bot.py
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override default SQLite cache location
INDIASCREEN_CACHE_DIR=~/.indiascreen

# Required to run backend/app.py — generate with: openssl rand -hex 32
BACKEND_SECRET_KEY=

# Optional: defaults to a local SQLite file. Point at Postgres for
# multi-user/production use, e.g.:
# DATABASE_URL=postgresql://user:pass@host:5432/indiascreen
DATABASE_URL=sqlite:///./indiascreen_backend.db
